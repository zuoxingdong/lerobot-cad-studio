{
  "schema": "rps/models@1",
  "doc": "Each entry: model (blender/models/<model>.py), anchor, match, optional follow {part: regex}, optional hide {mat, body, box, not_box (mm, in the instance frame), force (regex for named moving geoms)}; a follow part takes its whole rigid body.",
  "models": [
    {
      "model": "lh",
      "anchor": "^decor_lh_white$",
      "match": "^decor_lh_(white|glass|grey|alu|labware|tips|wells|gantry|head)$|^anim_lh_(gantry_[01]|led_0)$",
      "follow": {
        "gantry": "^anim_lh_gantry_0$",
        "head": "^anim_lh_gantry_1$",
        "led": "^anim_lh_led_0$"
      },
      "hide": {
        "mat": "^dm_(accent|inst_white|screen|led_green|ui_text)$",
        "box": [
          -440,
          440,
          100,
          600,
          0,
          800
        ]
      }
    },
    {
      "model": "inc",
      "anchor": "^decor_inc_body$",
      "match": "^decor_inc_(body|knuckle|lid|ring|temp)$|^anim_inc_(lid|led|ring)_0$",
      "follow": {
        "lid": "^anim_inc_lid_0$",
        "led": "^anim_inc_led_0$",
        "ring": "^anim_inc_ring_0$"
      },
      "hide": {
        "mat": "^dm_(screen|accent)$",
        "box": [
          -160,
          160,
          100,
          420,
          0,
          260
        ]
      }
    },
    {
      "model": "reader",
      "anchor": "^decor_reader_body$",
      "match": "^decor_reader_(body|knuckle|optics|hood|glow|labels)$|^anim_reader_(lid|glow|led)_0$",
      "follow": {
        "lid": "^anim_reader_lid_0$",
        "glow": "^anim_reader_glow_0$",
        "led": "^anim_reader_led_0$"
      },
      "hide": {
        "mat": "^dm_(screen|accent)$",
        "box": [
          -190,
          190,
          100,
          430,
          0,
          260
        ]
      }
    },
    {
      "model": "nest",
      "anchor": "^nest_(lh|inc|reader)$",
      "match": "^nest_(lh|inc|reader)$"
    },
    {
      "model": "plinth",
      "anchor": "^decor_tag_(lh|inc|reader)$",
      "match": "^decor_tag_(lh|inc|reader)$|^anim_(lh|inc|reader)_strip_0$",
      "follow": {
        "led": "^anim_(lh|inc|reader)_strip_0$"
      },
      "hide": {
        "mat": "^dm_(frame_dark|kick_dark|slab_white|hazard_yellow|tag_white|tag_black)$",
        "box": [
          -460,
          460,
          -10,
          570,
          0,
          290
        ]
      }
    },
    {
      "model": "puck",
      "anchor": "^nest_lh$",
      "match": "^decor_tube_(label|band)$",
      "follow": {
        "puck": "^puck_1_liquid_1$"
      },
      "hide": {
        "body": "^puck_1$",
        "mat": "^dm_"
      }
    },
    {
      "model": "room",
      "anchor": "^decor_dash_text$",
      "match": "(?!)",
      "hide": {
        "mat": "^dm_(wall|skirting|glass|frosted|alu|light|steel)$",
        "box": [
          -2300,
          2400,
          -1700,
          2100,
          0,
          2800
        ],
        "not_box": [
          -1500,
          1500,
          -500,
          1400,
          0,
          2340
        ]
      }
    },
    {
      "model": "floor",
      "anchor": "^decor_dash_text$",
      "match": "^decor_(keepout|stripes|label)_(lh|inc|reader)$",
      "hide": {
        "mat": "^dm_(hazard_yellow|paint_white)$",
        "box": [
          -2100,
          2300,
          -1500,
          1950,
          0,
          3
        ],
        "force": "^floor$"
      }
    },
    {
      "model": "dock",
      "anchor": "^decor_dash_text$",
      "match": "^decor_estop_(red|ring)$",
      "hide": {
        "mat": "^dm_(dock_dark|copper|inst_white|frame_dark|led_green|hazard_yellow)$",
        "box": [
          -400,
