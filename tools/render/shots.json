{
 "schema": "rps/campath@1",
 "doc": "The hero edit (a 65 s cut: establish, grasp, carry, insert, incubate, re-pick, transit, place, read, learn, dock; 28-100 mm lenses, slides <= 0.25 m/s) on the run's one 1x clock. A shot runs from `from` to the next shot's; times are seconds, a phase (its start, .end), or station:state, with +/-s. key: the review still of the shot. keep_out: segments never nearer than the robot. eye/target/focus/subjects: {at: world|base|body:|site:|station:|nest:|park:, p: offset in the anchor's frame (m), to: the end offset}. Station frames: +x across the plinth, +y into it, z up; nest z = the plinth top. lens_mm on a 24 mm-high frame. Tracks: pip (robot cameras), captions, cards.",
 "sensor_h_mm": 24,
 "tau_s": 0.5,
 "keep_out": [{"id": "estop", "p": [-0.60, -0.25, 0.0], "to": [-0.60, -0.25, 0.86], "r": 0.05}],
 "shots": [
  {"id": "establish", "key": 4.0, "from": 0, "lens_mm": 28, "fstop": 8, "ease": 0.4,
   "eye": {"at": "world", "p": [1.55, -1.25, 1.72], "to": [1.40, -1.05, 1.68]},
   "target": {"at": "world", "p": [-0.25, 0.75, 0.50]},
   "focus": {"at": "base", "p": [0, 0, 0.3]},
   "subjects": [{"at": "base", "p": [0, 0, 0.3]}, {"at": "nest:lh", "p": [0, 0, 0.05]}, {"at": "nest:inc", "p": [0, 0, 0.05]}, {"at": "nest:reader", "p": [0, 0, 0.05]}],
   "ok": ["st_lh", "st_inc", "st_reader"]},
  {"id": "grasp", "key": "grasp_lh+0.4", "from": "approach_lh", "lens_mm": 85, "fstop": 4, "ease": 0.4,
   "eye": {"at": "nest:lh", "p": [-0.66, -0.62, 0.10], "to": [-0.52, -0.74, 0.10]},
   "target": {"at": "body:puck_1", "p": [0, 0, 0.05]},
   "focus": {"at": "body:puck_1", "p": [0, 0, 0.06]}},
  {"id": "carry", "key": "carry_lh+2.5", "from": "carry_lh", "lens_mm": 35, "fstop": 8, "ease": 0.3,
   "eye": {"at": "base", "p": [0.08, -1.00, 0.55]},
   "target": {"at": "base", "p": [0.16, 0.0, 0.26]},
   "focus": {"at": "base", "p": [0, 0, 0.3]}},
  {"id": "insert", "key": "insert_inc+1.0", "from": "place_inc", "lens_mm": 100, "fstop": 5.6, "ease": 0.4,
   "eye": {"at": "nest:inc", "p": [0.75, -0.29, 0.44], "to": [0.66, -0.25, 0.39]},
   "target": {"at": "nest:inc", "p": [0, -0.035, 0.085], "to": [0, -0.015, 0.065]},
   "focus": {"at": "body:puck_1", "p": [0, 0, 0.04]}},
  {"id": "incubate", "key": "inc:running+1.5", "from": "backoff_inc", "lens_mm": 50, "fstop": 5.6, "ease": 0.4,
   "eye": {"at": "world", "p": [0.13, 0.06, 0.50], "to": [0.19, 0.04, 0.50]},
   "target": {"at": "nest:inc", "p": [0.0, 0.12, 0.08]},
   "subjects": [{"at": "nest:inc", "p": [0, 0.03, 0.10]}, {"at": "base", "p": [0, 0, 0.2]}],
   "focus": {"at": "base", "p": [0, 0, 0.3]},
   "rack": {"t": "inc:closing-0.5", "s": 1.0, "to": {"at": "nest:inc", "p": [0, 0.1, 0.08]}}},
  {"id": "repick", "key": "grasp_inc+0.4", "from": "return_inc", "lens_mm": 50, "fstop": 5.6, "ease": 0.4,
   "eye": {"at": "nest:inc", "p": [0.32, -0.86, 0.42], "to": [0.28, -0.80, 0.42]},
   "target": {"at": "nest:inc", "p": [0, 0, 0.06], "to": [0, -0.02, 0.14]},
   "focus": {"at": "body:puck_1", "p": [0, 0, 0.06]}},
  {"id": "transit", "key": "drive_reader+1.5", "from": "drive_mid", "lens_mm": 28, "fstop": 8, "ease": 0.35, "orbit_deg": -10,
   "eye": {"at": "world", "p": [0.35, -0.85, 2.52]},
   "target": {"at": "base", "p": [0, 0, 0.15]},
   "focus": {"at": "base", "p": [0, 0, 0.2]}},
  {"id": "place_reader", "key": "insert_reader+1.0", "from": "place_reader", "lens_mm": 85, "fstop": 4, "ease": 0.4,
   "eye": {"at": "nest:reader", "p": [-0.60, -0.64, 0.12], "to": [-0.48, -0.74, 0.12]},
   "target": {"at": "nest:reader", "p": [0, -0.06, 0.095], "to": [0, -0.04, 0.085]},
   "focus": {"at": "body:puck_1", "p": [0, 0, 0.06]}},
  {"id": "read", "key": "reader:running+1.5", "from": "drive_dock", "lens_mm": 50, "fstop": 5.6, "ease": 0.4,
   "eye": {"at": "world", "p": [-0.15, -0.30, 0.60], "to": [-0.17, -0.26, 0.58]},
   "target": {"at": "nest:reader", "p": [0.0, 0.10, 0.10]},
   "subjects": [{"at": "nest:reader", "p": [0, 0.0, 0.08]}]},
  {"id": "learn", "key": "reader:done+1.6", "from": "reader:done", "lens_mm": 50, "fstop": 8, "ease": 0.4,
   "eye": {"at": "world", "p": [-0.74, 0.02, 1.46], "to": [-0.78, 0.10, 1.47]},
   "target": {"at": "world", "p": [-1.30, 1.92, 1.52]},
   "subjects": [{"at": "world", "p": [-1.30, 1.90, 1.60]}]},
  {"id": "dock", "key": "end-0.9", "from": "reader:done+2.3", "lens_mm": 45, "fstop": 8, "ease": 0.35,
   "eye": {"at": "world", "p": [0.75, -0.05, 0.72], "to": [0.88, -0.05, 0.80]},
   "target": {"at": "world", "p": [0.0, -0.02, 0.20]},
   "subjects": [{"at": "base", "p": [0, 0, 0.2]}]}
 ],
 "pip": [
  {"cam": "wrist", "t": ["approach_lh+1.2", "carry_lh-0.1"]},
  {"cam": "top", "t": ["carry_lh+0.4", "place_inc-0.1"]},
  {"cam": "top", "t": ["place_inc+0.4", "backoff_inc-0.1"]},
  {"cam": "wrist", "t": ["return_inc+0.4", "drive_mid-0.1"]},
  {"cam": "front", "t": ["drive_reader+0.4", "place_reader-0.1"]},
  {"cam": "wrist", "t": ["place_reader+0.4", "drive_dock-0.1"]},
  {"cam": "top", "t": ["drive_dock+0.4", "reader:done-0.1"]}
 ],
 "captions": [
  {"t": [0.8, 6.6], "kicker": "LeKiwi + PincOpen", "text": "Low-cost, 3D-printed · simulated in MuJoCo · 1× real time"},
  {"t": ["approach_lh+0.9", "lift_lh+1.2"], "kicker": "Build", "text": "4 AI-designed candidates, picked up from the liquid handler"},
  {"t": ["carry_lh+0.8", "drive_inc+3.6"], "kicker": "Carry", "text": "Liquid handler → incubator"},
  {"t": ["inc:closing", "return_inc-0.1"], "kicker": "Test", "text": "Incubating 37 °C · {modelled} min shown as {run} s (time-compressed ×{x})", "clock": "incubation"},
  {"t": ["drive_mid+0.6", "drive_reader+3.2"], "kicker": "Carry", "text": "Incubator → reader"},
  {"t": ["reader:closing", "reader:done"], "kicker": "Test", "text": "Reading fluorescence · ex 480 / em 520 nm"},
  {"t": ["reader:done+0.2", "end-0.7"], "kicker": "Learn", "text": "ART-3: hit → next design round"}
 ],
 "edit": {"incubation_min": 30, "fade_in_s": 0.6, "fade_out": "end", "fade_out_s": 0.7},
 "cards": {
  "title": {"s": 3.5, "title": "LeKiwi + PincOpen", "sub": "A low-cost, 3D-printed mobile manipulator doing sample logistics in a self-driving biolab"},
  "end": {"s": 4.0, "title": "LeKiwi + PincOpen", "sub": "A low-cost, 3D-printed mobile manipulator doing sample logistics in a self-driving biolab",
          "notes": ["one {len} s run · 1× real time · incubation time-compressed ×{x}", "LeRobot CAD Studio"]}
 }
